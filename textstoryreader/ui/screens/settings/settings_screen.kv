<SettingsScreen>:
    name: 'settings_screen'

    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10

        # --- Tiêu đề ---
        Label:
            text: 'Cài đặt giao diện'
            font_size: '24sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.size
            size_hint_y: None
            height: dp(60) # Cố định chiều cao

        # --- Chọn kích cỡ chữ ---
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: 10
            Label:
                text: 'Kích cỡ chữ:'
                size_hint_x: None
                width: self.texture_size[0] + 20
            Slider:
                id: font_size_slider
                min: 18
                max: 42
                value: root.font_size
                step: 1
                size_hint_x: 0.7
                on_value: root.font_size = self.value
            Label:
                id: font_size_value
                text: str(int(root.font_size))
                size_hint_x: None
                width: self.texture_size[0] + 20

        # --- Chọn màu chữ ---
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: 10
            Label:
                text: 'Màu chữ:'
                size_hint_x: None
                width: self.texture_size[0] + 20
            BoxLayout:
                id: text_color_box
                size_hint_x: 0.7
                canvas:
                    Color:
                        # Ràng buộc màu nền của BoxLayout với thuộc tính text_color
                        rgba: root.text_color
                    Rectangle:
                        pos: self.pos
                        size: self.size
            Button:
                text: 'Chọn màu chữ'
                size_hint_x: 0.3
                on_release: root.open_color_picker('text_color')
        # --- Chọn màu nền ---
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: 10
            Label:
                text: 'Màu nền:'
                size_hint_x: None
                width: self.texture_size[0] + 20
            BoxLayout:
                id: background_color_box
                size_hint_x: 0.7
                canvas:
                    Color:
                        # Ràng buộc màu nền của BoxLayout với thuộc tính background_color
                        rgba: root.background_color
                    Rectangle:
                        pos: self.pos
                        size: self.size
            Button:
                text: 'Chọn màu nền'
                size_hint_x: 0.3
                on_release: root.open_color_picker('background_color')
        # --- Chọn font ---
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: 10
            Label:
                text: 'Font chữ:'
                size_hint_x: None
                width: self.texture_size[0] + 20
            Spinner:
                id: font_spinner
                text: root.font_name  # Hiển thị font đang được chọn
                values: root.font_list
                on_text: root.font_name = self.text  # Danh sách động nạp trong on_pre_enter

        # --- Các nút thao tác ---
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            Button:
                text: 'Quay Lại'
                on_release: root.go_back()
            
            Button:
                text: 'Lưu'
                on_release: root.save_settings()

            Button:
                text: 'Đặt Lại'
                on_release: root.reset_settings()