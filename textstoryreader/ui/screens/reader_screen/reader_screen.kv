<ReaderScreen>:
    BoxLayout:
        orientation: 'vertical'
        
        # Màu nền (nếu bạn có canvas riêng thì thêm ở đây), ví dụ:
        canvas.before:
            Color:
                rgba: root.background_color
            Rectangle:
                pos: self.pos
                size: self.size

        # Layout cho nội dung chính của trang
        BoxLayout:
            id: content_container
            orientation: 'vertical'
            size_hint: 1, 1 # Đảm bảo BoxLayout chiếm toàn bộ không gian còn lại
            padding: dp(15), dp(20)

            Label:
                id: chapter_content
                text: root.page_content  # Thay đổi thành page_content
                font_name: root.font_name
                font_size: sp(root.font_size)
                color: root.text_color
                text_size: self.width, None
                size_hint_y: 1 # Đảm bảo Label tự giãn nở để lấp đầy không gian
                valign: 'top'
                halign: 'left'
                line_height: root.line_spacing
                canvas_texture_size: None, None
        
        # Layout cho các nút điều hướng trang và chương (thêm next/prev page)
        BoxLayout: 
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(60)
            
            # Button: Go Back
            Button:
                size_hint_y: None
                height: dp(50)
                on_release: root.go_back()
                # background_normal: ''
                # background_down: ''
                # padding: dp(5)
                # background_color: 0, 0, 0, 0
                Image:
                    source: 'textstoryreader/assets/icons/back.png'
                    pos: self.parent.pos
                    size: self.parent.size
                    allow_stretch: True
                    keep_ratio: True
            
            # Button: Previous Page
            Button:
                size_hint_y: None
                height: dp(50)
                on_release: root.go_to_previous_page()  # Thêm hàm chuyển trang
                # background_normal: ''
                # background_down: ''
                # padding: dp(5)
                # background_color: 0, 0, 0, 0
                Image:
                    source: 'textstoryreader/assets/icons/back_page.png'
                    pos: self.parent.pos
                    size: self.parent.size
                    allow_stretch: True
                    keep_ratio: True
            
            # Button: Previous Chapter
            # Button:
            #     size_hint_y: None
            #     height: dp(50)
            #     on_release: root.back_chapter()
            #     background_normal: ''
            #     background_down: ''
            #     padding: dp(5)
            #     background_color: 0, 0, 0, 0
            #     Image:
            #         source: 'textstoryreader/assets/icons/back_page.png'
            #         pos: self.parent.pos
            #         size: self.parent.size
            #         allow_stretch: True
            #         keep_ratio: True
            
            # Button: Chapter List
            Button:
                size_hint_y: None
                height: dp(50)
                on_release: app.root.current = 'chapter_screen'
                # background_normal: ''
                # background_down: ''
                # padding: dp(5)
                # background_color: 0, 0, 0, 0
                Image:
                    source: 'textstoryreader/assets/icons/chapter_list.png'
                    pos: self.parent.pos
                    size: self.parent.size
                    allow_stretch: True
                    keep_ratio: True

            # Button: Next Chapter
            # Button:
            #     size_hint_y: None
            #     height: dp(50)
            #     on_release: root.next_chapter()
            #     background_normal: ''
            #     background_down: ''
            #     padding: dp(5)
            #     background_color: 0, 0, 0, 0
            #     Image:
            #         source: 'textstoryreader/assets/icons/next_page.png'
            #         pos: self.parent.pos
            #         size: self.parent.size
            #         allow_stretch: True
            #         keep_ratio: True
                    
            # Button: Next Page
            Button:
                size_hint_y: None
                height: dp(50)
                on_release: root.go_to_next_page()  # Thêm hàm chuyển trang
                # background_normal: ''
                # background_down: ''
                # padding: dp(5)
                # background_color: 0, 0, 0, 0
                Image:
                    source: 'textstoryreader/assets/icons/next_page.png'
                    pos: self.parent.pos
                    size: self.parent.size
                    allow_stretch: True
                    keep_ratio: True

            # Button: Settings
            Button:
                size_hint_y: None
                height: dp(50)
                on_release: 
                    app.root.current = 'settings_screen'
                    app.root.get_screen('settings_screen').previous_screen = 'reader_screen'
                # background_normal: ''
                # background_down: ''
                # padding: dp(5)
                # background_color: 0, 0, 0, 0
                Image:
                    source: 'textstoryreader/assets/icons/settings.png'
                    pos: self.parent.pos
                    size: self.parent.size
                    allow_stretch: True
                    keep_ratio: True