<SettingsScreen>:
    name: 'settings_screen'

    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10

        # --- Tiêu đề ---
        Label:
            text: 'Cài đặt giao diện'
            font_size: '24sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.size
            size_hint_y: None
            height: dp(60) # Cố định chiều cao

        # --- Chọn kích cỡ chữ ---
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: 10
            Label:
                text: 'Kích cỡ chữ:'
                size_hint_x: None
                width: self.texture_size[0] + 20
            Spinner:
                id: font_size_spinner
                text: 'Vừa'
                values: ['Nhỏ', 'Vừa', 'Lớn']

        # --- Chọn màu chữ ---
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: 10
            Label:
                text: 'Màu chữ:'
                size_hint_x: None
                width: self.texture_size[0] + 20
            Spinner:
                id: color_spinner
                text: '#000000'
                values: ['#000000', '#FFFFFF', '#FF0000', '#00FF00', '#0000FF', '#FFFF00', '#FF00FF', '#00FFFF']

        # --- Chọn font ---
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: 10
            Label:
                text: 'Font chữ:'
                size_hint_x: None
                width: self.texture_size[0] + 20
            Spinner:
                id: font_spinner
                text: 'Chọn font'
                # values: root.font_list   # Danh sách động nạp trong on_pre_enter

        # --- Các nút thao tác ---
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            Button:
                text: 'Lưu'
                on_release: root.save_settings()
            Button:
                text: 'Mặc định'
                on_release: root.reset_settings()
            Button:
                text: 'Back'
                on_release: app.root.current = 'library_screen'
